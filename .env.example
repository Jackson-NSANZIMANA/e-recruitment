# ═══════════════════════════════════════════════════════════════
# USRP — UNIFIED SECURITY RECRUITMENT PORTAL
# Environment Variables Reference
# 
# SECURITY NOTICE: This file documents required variables.
# Copy to .env for local development ONLY.
# NEVER commit .env to version control.
# Production secrets are managed via HSM + Kubernetes Secrets.
# ═══════════════════════════════════════════════════════════════

# ── NODE ───────────────────────────────────────────────────────
NODE_ENV=development

# ── POSTGRESQL ─────────────────────────────────────────────────
# Single application login role. usrp_app carries NO privileges of its own;
# every adapter assumes an agency/system group role per-transaction via
# `SET LOCAL ROLE` (see packages/shared-database/src/rls/0001). There are NO
# per-schema / per-officer login connection strings — the officer roles are
# NOLOGIN group roles, not direct logins.
DATABASE_URL=postgresql://usrp_app:app_pw@localhost:5432/usrp_db
# Postgres admin (migrations + applying rls/* only)
POSTGRES_USER=usrp_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=usrp_db
# PII column encryption key (in production: fetched from HSM)
DB_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_MIN_AES256_KEY

# ── REDIS — REMOVED 2026-07-19 ──────────────────────────────────
# The note said "re-add with real config when a consumer exists". The edge
# session store was the obvious candidate — and it is deliberately NOT Redis.
# Postgres (public_core.edge_sessions) is already provisioned, already under
# FORCE'd RLS discipline, already in the backup and audit story, and adds no
# new infrastructure to a government deployment. Revisit Redis when session
# VOLUME justifies a second datastore, not before.
#
# NOTE: loadServiceConfig() used to hard-require REDIS_URL, so any caller
# would have failed to boot on a variable this file does not define. Fixed.

# ── KAFKA (KRaft mode — no Zookeeper) ────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=usrp-service
KAFKA_GROUP_ID_IDENTITY=usrp-identity-consumers
KAFKA_GROUP_ID_ELIGIBILITY=usrp-eligibility-consumers
KAFKA_GROUP_ID_FORENSICS=usrp-forensics-consumers
KAFKA_GROUP_ID_VETTING=usrp-vetting-consumers
KAFKA_GROUP_ID_SCHEDULING=usrp-scheduling-consumers
KAFKA_GROUP_ID_NOTIFICATION=usrp-notification-consumers
KAFKA_GROUP_ID_AUDIT=usrp-audit-consumers
SCHEMA_REGISTRY_URL=http://localhost:8081

# ── MINIO (Document Object Store) ──────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=usrp_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET_DOCUMENTS=usrp-documents
MINIO_BUCKET_FORENSICS=usrp-forensics-temp
# AES-256-GCM key for document encryption (in production: HSM)
MINIO_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_MIN_AES256_KEY

# ── AUTH (Ed25519 asymmetric bearer tokens) ──────────────────────
# The backend auth slice (@usrp/shared-auth) uses ASYMMETRIC Ed25519 tokens:
# the issuer signs with a private key; every service verifies with the PUBLIC
# key only. There is no shared HMAC secret to leak.
#
# AUTH_JWT_PUBLIC_KEY_B64 — base64 of the SPKI PEM public key. Required by
# EVERY service that exposes HTTP (it verifies inbound bearer tokens).
AUTH_JWT_PUBLIC_KEY_B64=CHANGE_ME_BASE64_SPKI_PEM
# AUTH_JWT_PRIVATE_KEY_B64 — base64 of the PKCS#8 PEM private key. ISSUER-ONLY
# (iam-service). NEVER ship this to verifying services; in production it lives
# in HSM/KMS.
# AUTH_JWT_PRIVATE_KEY_B64=CHANGE_ME_BASE64_PKCS8_PEM
JWT_ISSUER=usrp
JWT_AUDIENCE=usrp-services

# ── KONG — REMOVED 2026-07-19 (no ingress gateway in dev) ─────────────
# The BFF tier below is NOT a replacement for an ingress gateway. A gateway
# terminates TLS and routes; a BFF holds the credential the browser must never
# see and restores REST ergonomics over an exact-path transport. Both can exist.

# ── DEPRECATED: symmetric JWT/HMAC vars (NOT used by the backend) ─────
# The backend auth slice is Ed25519-asymmetric (see AUTH block above); these
# shared-secret vars are unused by any service. Do not wire new code to them.
# KONG_JWT_SECRET=CHANGE_ME
# JWT_SECRET=CHANGE_ME_64_CHAR_MIN
# JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_MIN
# JWT_BIOMETRIC_SECRET=CHANGE_ME_64_CHAR_MIN

# ── G2G: NIDA INTEGRATION ─────────────────────────────────────
# In development: points to mock server
# In production: private VPN tunnel endpoint
NIDA_API_BASE_URL=http://localhost:3100
NIDA_API_KEY=CHANGE_ME
NIDA_HMAC_SECRET=CHANGE_ME_64_CHAR_MIN
NIDA_VPN_TUNNEL_HOST=localhost
NIDA_REQUEST_TIMEOUT_MS=5000
NIDA_MAX_RETRIES=3

# ── G2G: NESA INTEGRATION ─────────────────────────────────────
NESA_API_BASE_URL=http://localhost:3101
NESA_API_KEY=CHANGE_ME
NESA_HMAC_SECRET=CHANGE_ME_64_CHAR_MIN
NESA_REQUEST_TIMEOUT_MS=8000
NESA_MAX_RETRIES=3

# ── G2G: RIB INTEGRATION ──────────────────────────────────────
RIB_API_BASE_URL=http://localhost:3102
RIB_API_KEY=CHANGE_ME
RIB_HMAC_SECRET=CHANGE_ME_64_CHAR_MIN
RIB_REQUEST_TIMEOUT_MS=10000
RIB_MAX_RETRIES=2

# ── SMS NOTIFICATIONS (MTN/Airtel Rwanda) ────────────────────────
SMS_GATEWAY_PROVIDER=mtn
MTN_SMS_API_URL=https://api.mtn.rw/v1/sms
MTN_SMS_API_KEY=CHANGE_ME
MTN_SMS_SENDER_ID=USRP-RW
AIRTEL_SMS_API_URL=https://api.airtel.rw/v1/sms
AIRTEL_SMS_API_KEY=CHANGE_ME
AIRTEL_SMS_SENDER_ID=USRP-RW

# ── EMAIL NOTIFICATIONS ──────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=noreply@recruitment.gov.rw

# ── USSD GATEWAY (MTN/Airtel SMPP) ──────────────────────────────
USSD_SERVICE_CODE=*123#
USSD_GATEWAY_HOST=localhost
USSD_GATEWAY_PORT=2775
USSD_SYSTEM_ID=CHANGE_ME
USSD_PASSWORD=CHANGE_ME

# ── CLAMAV VIRUS SCANNER ──────────────────────────────────────
# On the document-upload ingress path (ADR-004): scan BEFORE the bytes are
# durably stored, so an infected file is never at rest in MinIO.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# ── WEBRTC / BIOMETRIC ───────────────────────────────────────
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302
BIOMETRIC_LIVENESS_THRESHOLD=0.85
BIOMETRIC_FACE_MATCH_THRESHOLD=85.0
BIOMETRIC_SESSION_TIMEOUT_MS=120000
# Ephemeral frame buffer TTL (milliseconds — frames purged after this)
BIOMETRIC_FRAME_BUFFER_TTL_MS=5000

# ═══════════════════════════════════════════════════════════════
# SERVICE PORTS — AUTHORITATIVE
#
# This block supersedes frontend-architecture.md §7 (which tells
# officer-console to call :4001 — that is identity-service, a microservice the
# browser must never reach — and applicant-portal to call :4000, where nothing
# runs at all).
#
# loadRuntimeConfig() DERIVES the variable name from the service name:
#   'identity-service' → PORT_IDENTITY_SERVICE   ('PORT_' + UPPER_SNAKE)
# One mechanical rule, no lookup table to drift. Rename a service, rename its
# variable. Precedence: PORT_<SERVICE_NAME> > PORT > 3000.
#
# Until this was wired, every line below was DECORATION: only the generic PORT
# was read, and with PORT unset all eleven services bound 3000 and collided.
# ═══════════════════════════════════════════════════════════════

# ── 4001–4011: MICROSERVICES (internal — never browser-facing) ───────
PORT_IDENTITY_SERVICE=4001
PORT_ELIGIBILITY_SERVICE=4002
PORT_BIOMETRIC_SERVICE=4003
# RENAMED from PORT_FORENSICS_SERVICE to match the package name
# (services/document-forensics-service). Nothing read the old name.
PORT_DOCUMENT_FORENSICS_SERVICE=4004
# RENAMED from PORT_VETTING_SERVICE for the same reason.
PORT_BACKGROUND_VETTING_SERVICE=4005
# 4006 was PORT_ROUTING_SERVICE — a service that does not exist. It belongs to
# application-service, the HTTP front door and application state owner, which
# had no port variable at all.
PORT_APPLICATION_SERVICE=4006
PORT_SCHEDULING_SERVICE=4007
PORT_NOTIFICATION_SERVICE=4008
PORT_FIELD_SYNC_SERVICE=4009
PORT_AUDIT_SERVICE=4010
# iam-service is the TOKEN ISSUER — the sole holder of the Ed25519 private key
# — and had no port variable whatsoever.
PORT_IAM_SERVICE=4011

# ── 4020–4024: EDGE / BFF TIER (the ONLY browser-facing processes) ────
# Replaces PORT_RDF_BFF / PORT_RNP_BFF / PORT_RCS_BFF / PORT_SUPERADMIN_BFF.
# Those names assumed three per-agency edges each serving "officers plus the
# applicants applying to that agency", which cannot work: a citizen's
# me-route is a UNION across all three ops schemas (ADR-018) and the
# cross-agency accept-lock (ADR-014) means a citizen inherently spans
# agencies. A per-agency citizen edge cannot serve its own core route.
#
# citizen-bff — ONE deployment, cross-agency by design (apps/applicant-portal)
PORT_CITIZEN_BFF=4020
# agency-bff — ONE codebase, THREE deployments (apps/officer-console). Each
# deployment sets PORT_AGENCY_BFF and AGENCY:
#   RDF → 4021    RNP → 4022    RCS → 4023
# Three codebases would be three places to forget one security fix.
PORT_AGENCY_BFF=4021
AGENCY=RDF
# admin-bff — superadmin + DPO surfaces
PORT_ADMIN_BFF=4024

# ── 3000–3005 / 3100–3103: NON-NODE PROCESSES (reference only) ───────
#   3000 applicant-portal (Next.js dev)   3100 NIDA mock
#   3001 officer-console  (Next.js dev)   3101 NESA mock
#   3002 admin-console    (Next.js dev)   3102 RIB  mock
#                                         3103 HEC  mock

# ── EDGE SESSION (BFF cookie tier) ──────────────────────────────
# The browser holds ONE opaque handle (__Host-usrp_sid) and nothing else. The
# upstream credential — the officer's Ed25519 JWT or the citizen's opaque
# session token — stays server-side in public_core.edge_sessions and never
# crosses to JavaScript. Consequence worth stating plainly: OFFICER SESSIONS
# BECOME REVOCABLE, which is the exact property ADR-018 demanded for citizens
# and which an Ed25519 bearer JWT cannot have on its own.
#
# EDGE_SESSION_HMAC_KEY keys the hash of the stored handle. A KEYED hash, not a
# bare digest: a leaked DB dump is then not a set of replayable handles.
EDGE_SESSION_HMAC_KEY=CHANGE_ME_32_CHAR_MIN_EDGE_SESSION_HMAC_KEY
# Sliding inactivity window (matches ADR-018's 30 min for citizens).
EDGE_SESSION_IDLE_TTL_SECONDS=1800
# HARD ceiling no activity extends — without it a sliding TTL is an immortal
# session that a thief keeps alive with their own traffic. 12h.
EDGE_SESSION_ABSOLUTE_TTL_SECONDS=43200
# MUST be true in production. The __Host- cookie prefix REQUIRES Secure, so
# shared-http refuses to serialize the session cookie when this is false over
# a real deployment. Kept false here only for plain-HTTP localhost.
EDGE_COOKIE_SECURE=false

# ── SECURITY ────────────────────────────────────────────────
# Allowed CORS origins (comma-separated). Read by loadCorsConfig() on the edge
# tier ONLY — an internal microservice no browser reaches emits no CORS
# headers at all. Exact-match allow-list: never a pattern, never '*' (the
# wildcard is forbidden alongside credentials, and cookies are the point).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005
# Rate limiting — the generic default. The edge tier layers per-NID and per-IP
# throttles on otp/request and officer login on top of this (ADR-018 #1 /
# ADR-020 #1): OTP costs real SMS money, and the uniform-202 no-enumeration
# property means an attacker gets zero feedback while burning the telecom budget.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_OTP_PER_NID_PER_HOUR=5
RATE_LIMIT_OTP_PER_IP_PER_HOUR=20
RATE_LIMIT_LOGIN_PER_IP_PER_HOUR=30
# WAF — block non-RW IPs during recruitment cycles (true/false)
WAF_COUNTRY_FILTER_ENABLED=false
WAF_ALLOWED_COUNTRY_CODES=RW

# ── DOCUMENT FORENSICS ───────────────────────────────────────
FORENSICS_ELA_QUALITY_THRESHOLD=90
FORENSICS_DCT_GAN_THRESHOLD=0.75
# Also the per-route body cap on the document-upload ingress. Raised for that
# ONE route via Route.maxBodyBytes — lifting the server-wide 64 KiB default
# would hand every other route the same large-payload DoS budget.
FORENSICS_MAX_FILE_SIZE_MB=10
FORENSICS_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf

# ── FIELD TABLET SYNC ────────────────────────────────────────
FIELD_SYNC_DEVICE_KEY_ALGORITHM=Ed25519
FIELD_SYNC_STALE_WRITE_THRESHOLD_MS=300000

# ── MONITORING ───────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3030
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ── FEATURE FLAGS ───────────────────────────────────────────
# Disable G2G calls and use mock data in development
FEATURE_USE_NIDA_MOCK=true
FEATURE_USE_NESA_MOCK=true
FEATURE_USE_RIB_MOCK=true
FEATURE_BIOMETRIC_ENABLED=true
FEATURE_USSD_ENABLED=false
FEATURE_WAF_ENABLED=false

# ── G2G: HEC INTEGRATION ──────────────────────────────────────
HEC_API_BASE_URL=http://localhost:3103
HEC_API_KEY=CHANGE_ME
HEC_HMAC_SECRET=CHANGE_ME_64_CHAR_MIN
HEC_REQUEST_TIMEOUT_MS=8000
HEC_MAX_RETRIES=3
FEATURE_USE_HEC_MOCK=true
