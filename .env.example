# ═══════════════════════════════════════════════════════════════
# USRP — UNIFIED SECURITY RECRUITMENT PORTAL
# Environment template — the SINGLE source every dev process reads.
#
#   bash scripts/generate-env.sh     -> renders .env (mints fresh dev keys)
#   pnpm dev                         -> sources .env, then turbo run dev
#
# CONTRACT: this file is not documentation, it is an ASSERTION. Every
# variable name here is the name the CODE reads — the canon in
# packages/shared-config/src/config.ts plus each service's src/config.ts.
# scripts/verify-dev-boot.sh boots the whole platform from THIS file on
# every gate run, so a name that drifts from the code turns the gate red.
# Change the code first; this file follows.
#
# SECURITY NOTICE: every key below is a WELL-KNOWN DEV VALUE, committed on
# purpose so a fresh clone boots — the same posture as the dev keypair in
# scripts/run-selfchecks.sh. They are worthless outside localhost.
# `pnpm generate:env` replaces them with freshly minted ones. Production
# secrets come from HSM/KMS + Kubernetes Secrets, never from a file.
# Never commit a real .env.
#
# AND THAT NOTICE IS NOW ENFORCED, NOT PROMISED. Every secret in this file is
# fingerprinted (SHA-256) by assertProductionSecrets() in
# packages/shared-config/src/production-guard.ts, which every service calls as
# the first statement of main(). A process started with NODE_ENV=production
# carrying any value from this file REFUSES TO BOOT — as do placeholder
# secrets, localhost endpoints and the FEATURE_USE_*_MOCK flags. Proven in
# both directions by packages/shared-config/selfcheck/verify-production-guard.ts.
# ═══════════════════════════════════════════════════════════════

# ── RUNTIME ───────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── POSTGRESQL ───────────────────────────────────────────────
# Single application login role. usrp_app carries NO privileges of its own;
# every adapter assumes an agency/system group role per-transaction via
# SET LOCAL ROLE (packages/shared-database/src/rls/0001). There are NO
# per-schema / per-officer login connection strings — the officer roles are
# NOLOGIN group roles, not direct logins.
DATABASE_URL=postgresql://usrp_app:app_pw@localhost:5432/usrp_db
DATABASE_MAX_CONNECTIONS=20
# Postgres admin — docker-compose + bootstrap-db.sh only (migrations, rls/*).
POSTGRES_USER=usrp_admin
POSTGRES_PASSWORD=usrp_dev_password
POSTGRES_DB=usrp_db

# ── KAFKA (KRaft mode — no Zookeeper) ───────────────────────────
# 29092 is the HOST listener (tier2 compose) and is what a service running
# on the host must use. 9092 is the in-network listener, reachable only from
# another container — pointing dev at it is why this line was wrong.
#
# NOT OPTIONAL IN PRODUCTION. resolveEventTransport() throws when this is
# unset and NODE_ENV=production: the in-memory fallback would leave every
# cross-service event undelivered and the immutable audit trail empty, while
# all eleven services still answered /health and /ready.
KAFKA_BROKERS=localhost:29092
KAFKA_SSL=false

# ── SERVICE PORTS ───────────────────────────────────────────
# Resolution order per service (loadRuntimeConfig in @usrp/shared-config):
#   PORT_<SERVICE_NAME>  ->  PORT  ->  3000
# The scoped names are DERIVED from the service name, which is what lets
# `turbo run dev --parallel` hand all eleven services ONE shared environment
# without them all resolving :3000 and fighting for the socket.
PORT_IDENTITY_SERVICE=4001
PORT_ELIGIBILITY_SERVICE=4002
PORT_BIOMETRIC_SERVICE=4003
PORT_DOCUMENT_FORENSICS_SERVICE=4004
PORT_BACKGROUND_VETTING_SERVICE=4005
PORT_APPLICATION_SERVICE=4006
PORT_SCHEDULING_SERVICE=4007
PORT_NOTIFICATION_SERVICE=4008
PORT_FIELD_SYNC_SERVICE=4009
PORT_AUDIT_SERVICE=4010
PORT_IAM_SERVICE=4011

# ── SECURITY: MASTER KEYS ────────────────────────────────────
# 32-char floor enforced at boot — a weak key here weakens every hashed
# National ID and every encrypted PII column. Production: HSM/KMS.
#
# A LENGTH FLOOR IS NOT A STRENGTH CHECK: 'CHANGE_ME_32_CHAR_MIN_AES256_KEY'
# is exactly 32 characters and would pass it. That is what the production
# guard is for.
NATIONAL_ID_HMAC_KEY='dev_national_id_hmac_key_min_32_chars!!'
PII_ENCRYPTION_KEY='dev_pii_encryption_key_min_32_chars_ok!!'

# ── AUTH: Ed25519 BEARER TOKENS (@usrp/shared-auth) ───────────────────
# Asymmetric by design: iam-service SIGNS with the private key; every other
# service VERIFIES with the public key only. There is no shared HMAC secret.
JWT_ISSUER=usrp
JWT_AUDIENCE=usrp-services
# base64 of the SPKI PEM. Required by EVERY service that exposes HTTP.
AUTH_JWT_PUBLIC_KEY_B64='LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUNvd0JRWURLMlZ3QXlFQUpjb2FtWEM1NFMvTk51UDRlcXVzLzh5dlhuTk5yTkRhK0JGWFFuSkU1QzQ9Ci0tLS0tRU5EIFBVQkxJQyBLRVktLS0tLQo='
# base64 of the PKCS#8 PEM. ISSUER-ONLY — iam-service is the sole minter.
# In production this key lives in an HSM and never touches a filesystem.
AUTH_JWT_PRIVATE_KEY_B64='LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCk1DNENBUUF3QlFZREsyVndCQ0lFSUlUaGJCTVJ0Sm9WQUwzUURrK29yZUgwVTludWw3RUNBNFdRRUxiV21LZmwKLS0tLS1FTkQgUFJJVkFURSBLRVktLS0tLQo='

# ── QR SLOT-INVITATION SIGNING (ADR-009) ───────────────────────────
# A SEPARATE keypair from AUTH above, deliberately. The public half is
# distributed to OFFLINE field devices at exam gates; reusing the token
# issuer's key would put the minting trust anchor on every tablet, so one
# stolen device would forge bearer tokens as well as slot invitations.
# Different trust domain -> different custody -> different rotation.
# scheduling-service signs with the private half (and derives + publishes
# the public half); biometric-service verifies with the public half.
# Rotate both pairs with `pnpm certs:rotate` (scripts/rotate-dev-certs.sh),
# which asserts they stay distinct even on a partial rotation.
QR_SIGNING_PRIVATE_KEY_B64='LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCk1DNENBUUF3QlFZREsyVndCQ0lFSUVHY05aNUdBbXFUbkpBVjI3ejNFc2JjU3hEcGh6ZTVjK2g5a2trSkhJbXQKLS0tLS1FTkQgUFJJVkFURSBLRVktLS0tLQo='
QR_INVITATION_PUBLIC_KEY_B64='LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUNvd0JRWURLMlZ3QXlFQVl5aTJVR3NBRjRjNnlJM0QrQ1J0aXpId1pUMFF6KzlFZ1BuRUVVUk9HNms9Ci0tLS0tRU5EIFBVQkxJQyBLRVktLS0tLQo='
QR_SIGNING_KEY_ID=dev-qr-key-1

# ── APPLICANT PORTAL MACHINE IDENTITY (ADR-016 / ADR-018) ───────────
# identity-service's me-routes call sibling services with a REAL
# client-credentials system token. These must match the ports above and the
# service client seeded by services/iam-service/scripts/seed-dev-officers.ts.
IAM_BASE_URL=http://localhost:4011
APPLICATION_SERVICE_BASE_URL=http://localhost:4006
IDENTITY_CLIENT_ID=dev.identity-portal
IDENTITY_CLIENT_SECRET='DevService#2026'

# ── G2G INTEGRATIONS ───────────────────────────────────────
# Dev: the mock servers in infrastructure/docker. Production: private VPN
# tunnel endpoints, with the HMAC secrets held in an HSM.
# NOTE the names — <AGENCY>_BASE_URL, NOT <AGENCY>_API_BASE_URL. The code
# canon (loadG2GConfig / loadNidaConfig / loadNesaConfig / loadHecConfig /
# loadRibConfig) is authoritative; the old _API_ spelling is what made
# background-vetting-service report RIB_BASE_URL missing.
G2G_TIMEOUT_MS=5000

NIDA_BASE_URL=http://localhost:3100
NIDA_HMAC_SECRET='dev_nida_hmac_secret'
NIDA_REQUEST_TIMEOUT_MS=5000

NESA_BASE_URL=http://localhost:3101
NESA_HMAC_SECRET='dev_nesa_hmac_secret'
NESA_REQUEST_TIMEOUT_MS=8000

RIB_BASE_URL=http://localhost:3102
RIB_HMAC_SECRET='dev_rib_hmac_secret'
RIB_REQUEST_TIMEOUT_MS=10000

HEC_BASE_URL=http://localhost:3103
HEC_HMAC_SECRET='dev_hec_hmac_secret'
HEC_REQUEST_TIMEOUT_MS=8000

# ── MINIO (document object store) ──────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=usrp_minio_admin
MINIO_ROOT_PASSWORD='usrp_minio_dev_password'
MINIO_BUCKET_DOCUMENTS=usrp-documents
MINIO_BUCKET_FORENSICS=usrp-forensics-temp
# Document-at-rest envelope (AES-256-GCM), REQUIRED to boot
# document-forensics-service since 07107ac. A store for scanned national IDs
# and birth certificates that can start without its encryption key is a store
# that will eventually run without one.
#
# This was CHANGE_ME_32_CHAR_MIN_AES256_KEY — exactly 32 characters, so it
# cleared the length floor and booted, sealing government identity documents
# under a key published in git. It now matches the dev value
# scripts/run-selfchecks.sh exports, so the gate and this template agree.
# Production: HSM/KMS.
MINIO_ENCRYPTION_KEY='dev_document_envelope_key_min_32_chars!!'

# ── CLAMAV VIRUS SCANNER ────────────────────────────────────
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# ── BIOMETRIC THRESHOLDS ────────────────────────────────────
BIOMETRIC_LIVENESS_THRESHOLD=0.85
BIOMETRIC_FACE_MATCH_THRESHOLD=85.0

# ── DOCUMENT FORENSICS TUNING ────────────────────────────────
FORENSICS_MAX_FILE_SIZE_MB=10
FORENSICS_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf

# ── FIELD TABLET SYNC ──────────────────────────────────────
FIELD_SYNC_DEVICE_KEY_ALGORITHM=Ed25519
FIELD_SYNC_STALE_WRITE_THRESHOLD_MS=300000

# ═══════════════════════════════════════════════════════════════
# EDGE TIER (BFF) — read by @usrp/shared-config, no deployment yet
#
# loadCorsConfig / loadEdgeSessionConfig / loadAgencyDeploymentConfig are
# real loaders reading real names. There is no citizen-bff or agency-bff in
# services/ yet, so nothing CALLS them — but the names are canon, so they
# belong here rather than in the unwired list below.
# ═══════════════════════════════════════════════════════════════

# citizen-bff is ONE cross-agency deployment: GET /v1/applicants/me/applications
# is a union across all three ops schemas (ADR-018) and ADR-014's cross-agency
# accept-lock means a citizen inherently spans agencies, so a per-agency citizen
# edge could not serve its own core route.
PORT_CITIZEN_BFF=4020
# agency-bff is ONE codebase whose three deployments each set PORT_AGENCY_BFF +
# AGENCY. Three codebases would be three places to forget the same security fix.
PORT_AGENCY_BFF=4021
AGENCY=RDF
PORT_ADMIN_BFF=4024

# The browser holds an opaque HANDLE; the upstream credential stays server-side.
# EDGE_SESSION_HMAC_KEY keys the STORED hash of that handle, so a leaked database
# dump is not a set of replayable sessions — which a placeholder key defeated
# entirely. Was CHANGE_ME_32_CHAR_MIN_EDGE_SESSION_HMAC_KEY. Production: HSM/KMS.
EDGE_SESSION_HMAC_KEY='dev_edge_session_hmac_key_min_32_chars!!'
# Two TTLs, not one: idle is sliding, absolute is a hard ceiling no amount of
# activity extends. A sliding TTL alone is an immortal session. Cross-field
# validated — absolute below idle cannot boot.
EDGE_SESSION_IDLE_TTL_SECONDS=1800
EDGE_SESSION_ABSOLUTE_TTL_SECONDS=43200
# false is correct for http://localhost dev ONLY. Browsers SILENTLY DROP a
# __Host- cookie that is not Secure, so shared-http refuses to serialize the
# session cookie at all rather than fail auth invisibly — and the production
# guard refuses to boot with this false.
EDGE_COOKIE_SECURE=false
# Exact-match allow-list, never a pattern. Credentialed cross-origin requests
# forbid '*', which is the whole point of the edge.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005

# ═══════════════════════════════════════════════════════════════
# DECLARED HERE, READ BY NOTHING (yet)
#
# Checked against the name canon in packages/shared-config/src/config.ts: no
# loader reads any of these. They are kept SET rather than removed because
# they have NOT been checked against all eleven per-service src/config.ts
# files, and deleting a name a service does read would break `pnpm dev` for
# every developer while looking like tidying. Under-claiming is free here.
#
# Do not treat this block as a contract. If you wire one of these up, move it
# into the section it belongs to and say what reads it.
# ═══════════════════════════════════════════════════════════════

# loadKafkaConfig takes clientId as a FUNCTION ARGUMENT (the service name),
# not from the environment, and no consumer-group name is read from here.
KAFKA_CLIENT_ID=usrp-service
KAFKA_GROUP_ID_IDENTITY=usrp-identity-consumers
KAFKA_GROUP_ID_ELIGIBILITY=usrp-eligibility-consumers
KAFKA_GROUP_ID_FORENSICS=usrp-forensics-consumers
KAFKA_GROUP_ID_VETTING=usrp-vetting-consumers
KAFKA_GROUP_ID_SCHEDULING=usrp-scheduling-consumers
KAFKA_GROUP_ID_NOTIFICATION=usrp-notification-consumers
KAFKA_GROUP_ID_AUDIT=usrp-audit-consumers

# G2G production transport. The mocks need none of this; the real tunnels will.
# These stay CHANGE_ME ON PURPOSE: they are unwired, and if one is ever wired
# without a real value the production guard refuses the boot. That is correct.
NIDA_API_KEY=CHANGE_ME
NIDA_VPN_TUNNEL_HOST=localhost
NIDA_MAX_RETRIES=3
NESA_API_KEY=CHANGE_ME
NESA_MAX_RETRIES=3
RIB_API_KEY=CHANGE_ME
RIB_MAX_RETRIES=2
HEC_API_KEY=CHANGE_ME
HEC_MAX_RETRIES=3

# Liveness capture tuning — the WebRTC slice is not started.
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302
BIOMETRIC_SESSION_TIMEOUT_MS=120000
BIOMETRIC_FRAME_BUFFER_TTL_MS=5000

# Analyzer tuning beyond what the bounded-real analyzer currently reads.
FORENSICS_ELA_QUALITY_THRESHOLD=90
FORENSICS_DCT_GAN_THRESHOLD=0.75

# Feature flags. The mock flags describe dev reality (the G2G mocks in
# infrastructure/docker ARE what dev talks to) but no code branches on them
# yet. The production guard refuses all four set to true under
# NODE_ENV=production: vetting and academic verification against FIXTURES
# would clear every applicant on a check no real authority performed.
FEATURE_USE_NIDA_MOCK=true
FEATURE_USE_NESA_MOCK=true
FEATURE_USE_RIB_MOCK=true
FEATURE_USE_HEC_MOCK=true
FEATURE_BIOMETRIC_ENABLED=true
FEATURE_USSD_ENABLED=false
FEATURE_WAF_ENABLED=false

# ═══════════════════════════════════════════════════════════════
# NOT YET WIRED — no service reads these. Deliberately listed but NOT set,
# so the boot proof stays honest and nobody re-invents the names later.
#
# An earlier edge-tier merge appended a block that SET thirty of these while
# this section claimed they were unset. A template that contradicts itself in
# one section is not trusted in any, so they are gone again — verified
# against the canon in packages/shared-config/src/config.ts.
#
#   REDIS_URL              no consumer exists (removed 2026-07-19). It is no
#                          longer required by loadServiceConfig either — that
#                          composite hard-required it for a dependency that
#                          does not exist, so nothing could boot from this file.
#   SCHEMA_REGISTRY_URL    no consumer exists
#   MTN_/AIRTEL_/SMS_      blocked on a telecom contract (ADR-021);
#                          @usrp/shared-sms ships LogSmsChannel in dev and
#                          notification-service composes exactly that
#   SMTP_*                 owner D13a: SMS-only, no email source
#   USSD_*                 ADR-018 follow-on
#   RATE_LIMIT_/WAF_       prod ingress boundary; no gateway in dev
#                          (CORS_ORIGINS is NO LONGER in this list —
#                           loadCorsConfig reads it; see the EDGE TIER section)
#   KONG_*                 no ingress gateway in dev (removed 2026-07-19)
#   JWT_SECRET and friends symmetric HMAC vars the Ed25519 design replaced
#   DB_ENCRYPTION_KEY      the dead old name NATIONAL_ID_HMAC_KEY hid behind
#                          (ebdc5b4). A dead SECRET name is worse than none:
#                          an operator sets it, believes PII is keyed, and it
#                          is not.
#   PROMETHEUS_/GRAFANA_   observability slice (not started)
# ═══════════════════════════════════════════════════════════════
