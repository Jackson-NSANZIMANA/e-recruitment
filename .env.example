# ══════════════════════════════════════════════════════════════════
# USRP — UNIFIED SECURITY RECRUITMENT PORTAL
# Environment template — the SINGLE source every dev process reads.
#
#   bash scripts/generate-env.sh     -> renders .env (mints fresh dev keys)
#   pnpm dev                         -> sources .env, then turbo run dev
#
# CONTRACT: this file is not documentation, it is an ASSERTION. Every
# variable name here is the name the CODE reads — the canon in
# packages/shared-config/src/config.ts plus each service's src/config.ts.
# scripts/verify-dev-boot.sh boots the whole platform from THIS file on
# every gate run, so a name that drifts from the code turns the gate red.
# Change the code first; this file follows.
#
# SECURITY NOTICE: every key below is a WELL-KNOWN DEV VALUE, committed on
# purpose so a fresh clone boots — the same posture as the dev keypair in
# scripts/run-selfchecks.sh. They are worthless outside localhost.
# `pnpm generate:env` replaces them with freshly minted ones. Production
# secrets come from HSM/KMS + Kubernetes Secrets, never from a file.
# Never commit a real .env.
# ══════════════════════════════════════════════════════════════════

# ── RUNTIME ───────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── POSTGRESQL ────────────────────────────────────────────────────
# Single application login role. usrp_app carries NO privileges of its own;
# every adapter assumes an agency/system group role per-transaction via
# SET LOCAL ROLE (packages/shared-database/src/rls/0001). There are NO
# per-schema / per-officer login connection strings — the officer roles are
# NOLOGIN group roles, not direct logins.
DATABASE_URL=postgresql://usrp_app:app_pw@localhost:5432/usrp_db
DATABASE_MAX_CONNECTIONS=20
# Postgres admin — docker-compose + bootstrap-db.sh only (migrations, rls/*).
POSTGRES_USER=usrp_admin
POSTGRES_PASSWORD=usrp_dev_password
POSTGRES_DB=usrp_db

# ── KAFKA (KRaft mode — no Zookeeper) ────────────────────────────
# 29092 is the HOST listener (tier2 compose) and is what a service running
# on the host must use. 9092 is the in-network listener, reachable only from
# another container — pointing dev at it is why this line was wrong.
KAFKA_BROKERS=localhost:29092
KAFKA_SSL=false

# ── SERVICE PORTS ─────────────────────────────────────────────────
# Resolution order per service (loadRuntimeConfig in @usrp/shared-config):
#   PORT_<SERVICE_NAME>  ->  PORT  ->  3000
# The scoped names are DERIVED from the service name, which is what lets
# `turbo run dev --parallel` hand all eleven services ONE shared environment
# without them all resolving :3000 and fighting for the socket.
PORT_IDENTITY_SERVICE=4001
PORT_ELIGIBILITY_SERVICE=4002
PORT_BIOMETRIC_SERVICE=4003
PORT_DOCUMENT_FORENSICS_SERVICE=4004
PORT_BACKGROUND_VETTING_SERVICE=4005
PORT_APPLICATION_SERVICE=4006
PORT_SCHEDULING_SERVICE=4007
PORT_NOTIFICATION_SERVICE=4008
PORT_FIELD_SYNC_SERVICE=4009
PORT_AUDIT_SERVICE=4010
PORT_IAM_SERVICE=4011

# ── SECURITY: MASTER KEYS ─────────────────────────────────────────
# 32-char floor enforced at boot — a weak key here weakens every hashed
# National ID and every encrypted PII column. Production: HSM/KMS.
NATIONAL_ID_HMAC_KEY='dev_national_id_hmac_key_min_32_chars!!'
PII_ENCRYPTION_KEY='dev_pii_encryption_key_min_32_chars_ok!!'

# ── AUTH: Ed25519 BEARER TOKENS (@usrp/shared-auth) ─────────────────
# Asymmetric by design: iam-service SIGNS with the private key; every other
# service VERIFIES with the public key only. There is no shared HMAC secret.
JWT_ISSUER=usrp
JWT_AUDIENCE=usrp-services
# base64 of the SPKI PEM. Required by EVERY service that exposes HTTP.
AUTH_JWT_PUBLIC_KEY_B64='LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUNvd0JRWURLMlZ3QXlFQUpjb2FtWEM1NFMvTk51UDRlcXVzLzh5dlhuTk5yTkRhK0JGWFFuSkU1QzQ9Ci0tLS0tRU5EIFBVQkxJQyBLRVktLS0tLQo='
# base64 of the PKCS#8 PEM. ISSUER-ONLY — iam-service is the sole minter.
# In production this key lives in an HSM and never touches a filesystem.
AUTH_JWT_PRIVATE_KEY_B64='LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCk1DNENBUUF3QlFZREsyVndCQ0lFSUlUaGJCTVJ0Sm9WQUwzUURrK29yZUgwVTludWw3RUNBNFdRRUxiV21LZmwKLS0tLS1FTkQgUFJJVkFURSBLRVktLS0tLQo='

# ── QR SLOT-INVITATION SIGNING (ADR-009) ───────────────────────────
# A SEPARATE keypair from AUTH above, deliberately. The public half is
# distributed to OFFLINE field devices at exam gates; reusing the token
# issuer's key would put the minting trust anchor on every tablet, so one
# stolen device would forge bearer tokens as well as slot invitations.
# Different trust domain -> different custody -> different rotation.
# scheduling-service signs with the private half (and derives + publishes
# the public half); biometric-service verifies with the public half.
QR_SIGNING_PRIVATE_KEY_B64='LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCk1DNENBUUF3QlFZREsyVndCQ0lFSUVHY05aNUdBbXFUbkpBVjI3ejNFc2JjU3hEcGh6ZTVjK2g5a2trSkhJbXQKLS0tLS1FTkQgUFJJVkFURSBLRVktLS0tLQo='
QR_INVITATION_PUBLIC_KEY_B64='LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUNvd0JRWURLMlZ3QXlFQVl5aTJVR3NBRjRjNnlJM0QrQ1J0aXpId1pUMFF6KzlFZ1BuRUVVUk9HNms9Ci0tLS0tRU5EIFBVQkxJQyBLRVktLS0tLQo='
QR_SIGNING_KEY_ID=dev-qr-key-1

# ── APPLICANT PORTAL MACHINE IDENTITY (ADR-016 / ADR-018) ───────────
# identity-service's me-routes call sibling services with a REAL
# client-credentials system token. These must match the ports above and the
# service client seeded by services/iam-service/scripts/seed-dev-officers.ts.
IAM_BASE_URL=http://localhost:4011
APPLICATION_SERVICE_BASE_URL=http://localhost:4006
IDENTITY_CLIENT_ID=dev.identity-portal
IDENTITY_CLIENT_SECRET='DevService#2026'

# ── G2G INTEGRATIONS ────────────────────────────────────────────
# Dev: the mock servers in infrastructure/docker. Production: private VPN
# tunnel endpoints, with the HMAC secrets held in an HSM.
# NOTE the names — <AGENCY>_BASE_URL, NOT <AGENCY>_API_BASE_URL. The code
# canon (loadG2GConfig / loadNidaConfig / loadNesaConfig / loadHecConfig /
# loadRibConfig) is authoritative; the old _API_ spelling is what made
# background-vetting-service report RIB_BASE_URL missing.
G2G_TIMEOUT_MS=5000

NIDA_BASE_URL=http://localhost:3100
NIDA_HMAC_SECRET='dev_nida_hmac_secret'
NIDA_REQUEST_TIMEOUT_MS=5000

NESA_BASE_URL=http://localhost:3101
NESA_HMAC_SECRET='dev_nesa_hmac_secret'
NESA_REQUEST_TIMEOUT_MS=8000

RIB_BASE_URL=http://localhost:3102
RIB_HMAC_SECRET='dev_rib_hmac_secret'
RIB_REQUEST_TIMEOUT_MS=10000

HEC_BASE_URL=http://localhost:3103
HEC_HMAC_SECRET='dev_hec_hmac_secret'
HEC_REQUEST_TIMEOUT_MS=8000

# ── MINIO (document object store) ────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=usrp_minio_admin
MINIO_ROOT_PASSWORD='usrp_minio_dev_password'
MINIO_BUCKET_DOCUMENTS=usrp-documents
MINIO_BUCKET_FORENSICS=usrp-forensics-temp

# ── CLAMAV VIRUS SCANNER ─────────────────────────────────────────
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# ── BIOMETRIC THRESHOLDS ─────────────────────────────────────────
BIOMETRIC_LIVENESS_THRESHOLD=0.85
BIOMETRIC_FACE_MATCH_THRESHOLD=85.0

# ── DOCUMENT FORENSICS TUNING ────────────────────────────────────
FORENSICS_MAX_FILE_SIZE_MB=10
FORENSICS_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf

# ── FIELD TABLET SYNC ────────────────────────────────────────────
FIELD_SYNC_DEVICE_KEY_ALGORITHM=Ed25519
FIELD_SYNC_STALE_WRITE_THRESHOLD_MS=300000

# ══════════════════════════════════════════════════════════════════
# NOT YET WIRED — no service reads these. Deliberately listed but NOT set,
# so the boot proof stays honest and nobody re-invents the names later.
#   REDIS_URL              no consumer exists (removed 2026-07-19)
#   SCHEMA_REGISTRY_URL    no consumer exists
#   MTN_/AIRTEL_ SMS       blocked on a telecom contract (ADR-021);
#                          @usrp/shared-sms ships LogSmsChannel in dev
#   SMTP_*                 owner D13a: SMS-only, no email source
#   USSD_*                 ADR-018 follow-on
#   CORS_/RATE_LIMIT_/WAF_ prod ingress boundary; no gateway in dev
#   KONG_*                 no ingress gateway in dev (removed 2026-07-19)
#   JWT_SECRET and friends symmetric HMAC vars the Ed25519 design replaced
#   PROMETHEUS_/GRAFANA_   observability slice (not started)
# ══════════════════════════════════════════════════════════════════

# EDGE-TIER VARIABLES
DB_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_MIN_AES256_KEY
KAFKA_CLIENT_ID=usrp-service
KAFKA_GROUP_ID_IDENTITY=usrp-identity-consumers
KAFKA_GROUP_ID_ELIGIBILITY=usrp-eligibility-consumers
KAFKA_GROUP_ID_FORENSICS=usrp-forensics-consumers
KAFKA_GROUP_ID_VETTING=usrp-vetting-consumers
KAFKA_GROUP_ID_SCHEDULING=usrp-scheduling-consumers
KAFKA_GROUP_ID_NOTIFICATION=usrp-notification-consumers
KAFKA_GROUP_ID_AUDIT=usrp-audit-consumers
SCHEMA_REGISTRY_URL=http://localhost:8081
MINIO_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_MIN_AES256_KEY
NIDA_API_KEY=CHANGE_ME
NIDA_VPN_TUNNEL_HOST=localhost
NIDA_MAX_RETRIES=3
NESA_BASE_URL=http://localhost:3101
