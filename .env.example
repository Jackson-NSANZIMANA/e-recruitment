# ══════════════════════════════════════════════════════════════════
# USRP — UNIFIED SECURITY RECRUITMENT PORTAL
# Environment Variables Reference
# 
# SECURITY NOTICE: This file documents required variables.
# Copy to .env for local development ONLY.
# NEVER commit .env to version control.
# Production secrets are managed via HSM + Kubernetes Secrets.
# ══════════════════════════════════════════════════════════════════

# ── NODE ──────────────────────────────────────────────────────────
NODE_ENV=development

# ── POSTGRESQL ────────────────────────────────────────────────────
# Main connection (used by all services via connection pool)
DATABASE_URL=postgresql://usrp_system:CHANGE_ME@localhost:5432/usrp_db
# Schema-specific connection strings
DATABASE_URL_PUBLIC_CORE=postgresql://usrp_public_reader:CHANGE_ME@localhost:5432/usrp_db?options=-csearch_path%3Dpublic_core
DATABASE_URL_RDF_OPS=postgresql://usrp_rdf_officer:CHANGE_ME@localhost:5432/usrp_db?options=-csearch_path%3Drdf_ops
DATABASE_URL_RNP_OPS=postgresql://usrp_rnp_officer:CHANGE_ME@localhost:5432/usrp_db?options=-csearch_path%3Drnp_ops
DATABASE_URL_RCS_OPS=postgresql://usrp_rcs_officer:CHANGE_ME@localhost:5432/usrp_db?options=-csearch_path%3Drcs_ops
# Postgres admin (migrations only)
POSTGRES_USER=usrp_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=usrp_db
# PII column encryption key (in production: fetched from HSM)
DB_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_MIN_AES256_KEY

# ── REDIS ─────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME@localhost:6379
REDIS_PASSWORD=CHANGE_ME
# USSD session TTL in seconds (72 hours)
REDIS_USSD_SESSION_TTL=259200
# JWT session TTL in seconds (8 hours)
REDIS_JWT_SESSION_TTL=28800

# ── KAFKA (KRaft mode — no Zookeeper) ────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=usrp-service
KAFKA_GROUP_ID_IDENTITY=usrp-identity-consumers
KAFKA_GROUP_ID_ELIGIBILITY=usrp-eligibility-consumers
KAFKA_GROUP_ID_FORENSICS=usrp-forensics-consumers
KAFKA_GROUP_ID_VETTING=usrp-vetting-consumers
KAFKA_GROUP_ID_SCHEDULING=usrp-scheduling-consumers
KAFKA_GROUP_ID_NOTIFICATION=usrp-notification-consumers
KAFKA_GROUP_ID_AUDIT=usrp-audit-consumers
SCHEMA_REGISTRY_URL=http://localhost:8081

# ── MINIO (Document Object Store) ────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=usrp_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET_DOCUMENTS=usrp-documents
MINIO_BUCKET_FORENSICS=usrp-forensics-temp
# AES-256-GCM key for document encryption (in production: HSM)
MINIO_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_MIN_AES256_KEY

# ── KONG API GATEWAY ──────────────────────────────────────────────
KONG_ADMIN_URL=http://localhost:8001
KONG_PROXY_URL=http://localhost:8000
KONG_JWT_SECRET=CHANGE_ME

# ── JWT AUTHENTICATION ────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_64_CHAR_MIN
JWT_EXPIRY=8h
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_MIN
JWT_REFRESH_EXPIRY=7d
# Short-lived tokens for biometric session
JWT_BIOMETRIC_SECRET=CHANGE_ME_64_CHAR_MIN
JWT_BIOMETRIC_EXPIRY=10m

# ── G2G: NIDA INTEGRATION ────────────────────────────────────────
# In development: points to mock server
# In production: private VPN tunnel endpoint
NIDA_API_BASE_URL=http://localhost:3100
NIDA_API_KEY=CHANGE_ME
NIDA_HMAC_SECRET=CHANGE_ME_64_CHAR_MIN
NIDA_VPN_TUNNEL_HOST=localhost
NIDA_REQUEST_TIMEOUT_MS=5000
NIDA_MAX_RETRIES=3

# ── G2G: NESA INTEGRATION ────────────────────────────────────────
NESA_API_BASE_URL=http://localhost:3101
NESA_API_KEY=CHANGE_ME
NESA_HMAC_SECRET=CHANGE_ME_64_CHAR_MIN
NESA_REQUEST_TIMEOUT_MS=8000
NESA_MAX_RETRIES=3

# ── G2G: RIB INTEGRATION ─────────────────────────────────────────
RIB_API_BASE_URL=http://localhost:3102
RIB_API_KEY=CHANGE_ME
RIB_HMAC_SECRET=CHANGE_ME_64_CHAR_MIN
RIB_REQUEST_TIMEOUT_MS=10000
RIB_MAX_RETRIES=2

# ── SMS NOTIFICATIONS (MTN/Airtel Rwanda) ────────────────────────
SMS_GATEWAY_PROVIDER=mtn
MTN_SMS_API_URL=https://api.mtn.rw/v1/sms
MTN_SMS_API_KEY=CHANGE_ME
MTN_SMS_SENDER_ID=USRP-RW
AIRTEL_SMS_API_URL=https://api.airtel.rw/v1/sms
AIRTEL_SMS_API_KEY=CHANGE_ME
AIRTEL_SMS_SENDER_ID=USRP-RW

# ── EMAIL NOTIFICATIONS ───────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=noreply@recruitment.gov.rw

# ── USSD GATEWAY (MTN/Airtel SMPP) ───────────────────────────────
USSD_SERVICE_CODE=*123#
USSD_GATEWAY_HOST=localhost
USSD_GATEWAY_PORT=2775
USSD_SYSTEM_ID=CHANGE_ME
USSD_PASSWORD=CHANGE_ME

# ── CLAMAV VIRUS SCANNER ──────────────────────────────────────────
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# ── WEBRTC / BIOMETRIC ────────────────────────────────────────────
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302
BIOMETRIC_LIVENESS_THRESHOLD=0.85
BIOMETRIC_FACE_MATCH_THRESHOLD=85.0
BIOMETRIC_SESSION_TIMEOUT_MS=120000
# Ephemeral frame buffer TTL (milliseconds — frames purged after this)
BIOMETRIC_FRAME_BUFFER_TTL_MS=5000

# ── SERVICE PORTS ─────────────────────────────────────────────────
PORT_IDENTITY_SERVICE=4001
PORT_ELIGIBILITY_SERVICE=4002
PORT_BIOMETRIC_SERVICE=4003
PORT_FORENSICS_SERVICE=4004
PORT_VETTING_SERVICE=4005
PORT_ROUTING_SERVICE=4006
PORT_SCHEDULING_SERVICE=4007
PORT_NOTIFICATION_SERVICE=4008
PORT_FIELD_SYNC_SERVICE=4009
PORT_AUDIT_SERVICE=4010
PORT_RDF_BFF=4021
PORT_RNP_BFF=4022
PORT_RCS_BFF=4023
PORT_SUPERADMIN_BFF=4024

# ── SECURITY ──────────────────────────────────────────────────────
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005
# Rate limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# WAF — block non-RW IPs during recruitment cycles (true/false)
WAF_COUNTRY_FILTER_ENABLED=false
WAF_ALLOWED_COUNTRY_CODES=RW

# ── DOCUMENT FORENSICS ────────────────────────────────────────────
FORENSICS_ELA_QUALITY_THRESHOLD=90
FORENSICS_DCT_GAN_THRESHOLD=0.75
FORENSICS_MAX_FILE_SIZE_MB=10
FORENSICS_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf

# ── FIELD TABLET SYNC ────────────────────────────────────────────
FIELD_SYNC_DEVICE_KEY_ALGORITHM=Ed25519
FIELD_SYNC_STALE_WRITE_THRESHOLD_MS=300000

# ── MONITORING ────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3030
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ── FEATURE FLAGS ────────────────────────────────────────────────
# Disable G2G calls and use mock data in development
FEATURE_USE_NIDA_MOCK=true
FEATURE_USE_NESA_MOCK=true
FEATURE_USE_RIB_MOCK=true
FEATURE_BIOMETRIC_ENABLED=true
FEATURE_USSD_ENABLED=false
FEATURE_WAF_ENABLED=false

# ── G2G: HEC INTEGRATION ─────────────────────────────────────────
HEC_API_BASE_URL=http://localhost:3103
HEC_API_KEY=CHANGE_ME
HEC_HMAC_SECRET=CHANGE_ME_64_CHAR_MIN
HEC_REQUEST_TIMEOUT_MS=8000
HEC_MAX_RETRIES=3
FEATURE_USE_HEC_MOCK=true
