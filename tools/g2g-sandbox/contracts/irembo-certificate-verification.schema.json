{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "usrp:g2g-sandbox:irembo-certificate-verification",
  "title": "IremboGov certificate verification \u2014 GET /irembo/rest/public/request/verify-certificate-by-application-number (found)",
  "description": "Shape only, from a third person's certificate (ADR-047 \u00a72.2): no value from it appears anywhere. Irembo answers in TWO shapes: a certificate IN FORCE carries every field; one NOT in force (expired or withdrawn) carries only STATUS and APPLICATION_CODE, the holder's details withheld. Both are modelled, so the simulator can reproduce an expired certificate \u2014 the common real case. For S12b's irembo-certificates simulator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "data",
    "responseCode",
    "message",
    "responseEncrypted",
    "traceId"
  ],
  "properties": {
    "status": {
      "type": "boolean"
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ISSUED_ON": {
              "type": "string",
              "pattern": "^[0-9]{2}/[0-9]{2}/[0-9]{4}$"
            },
            "STATUS": {
              "const": true
            },
            "REFERENCE_NUMBER": {
              "type": "string",
              "pattern": "^[A-Z][0-9]{12}[A-Z0-9]{4}$"
            },
            "SIGNED_BY": {
              "type": "string"
            },
            "DATE_OF_BIRTH": {
              "type": "string",
              "pattern": "^[0-9]{2}/[0-9]{2}/[0-9]{4}$"
            },
            "APPLICATION_CODE": {
              "type": "string",
              "pattern": "^[A-Z0-9_]+$"
            },
            "NAME": {
              "type": "string"
            }
          },
          "required": [
            "ISSUED_ON",
            "STATUS",
            "REFERENCE_NUMBER",
            "SIGNED_BY",
            "DATE_OF_BIRTH",
            "APPLICATION_CODE",
            "NAME"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "STATUS",
            "APPLICATION_CODE"
          ],
          "properties": {
            "STATUS": {
              "const": false
            },
            "APPLICATION_CODE": {
              "type": "string",
              "pattern": "^[A-Z0-9_]+$"
            }
          }
        }
      ]
    },
    "responseCode": {
      "type": "string",
      "pattern": "^[0-9]{4}$"
    },
    "message": {
      "type": "string"
    },
    "responseEncrypted": {
      "type": "boolean"
    },
    "traceId": {
      "type": "string",
      "minLength": 8
    }
  }
}