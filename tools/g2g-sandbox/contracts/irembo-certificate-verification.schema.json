{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "usrp:g2g-sandbox:irembo-certificate-verification",
  "title": "IremboGov certificate verification — GET /irembo/rest/public/request/verify-certificate-by-application-number (found)",
  "description": "Shape only, from a third person's certificate (ADR-047 §2.2): no value from it appears anywhere. For S12b's irembo-certificates simulator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "data", "responseCode", "message", "responseEncrypted", "traceId"],
  "properties": {
    "status": { "type": "boolean" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ISSUED_ON", "STATUS", "REFERENCE_NUMBER", "SIGNED_BY", "DATE_OF_BIRTH", "APPLICATION_CODE", "NAME"],
      "properties": {
        "ISSUED_ON": { "type": "string", "pattern": "^[0-9]{2}/[0-9]{2}/[0-9]{4}$" },
        "STATUS": { "type": "boolean" },
        "REFERENCE_NUMBER": { "type": "string", "pattern": "^[A-Z][0-9]{12}[A-Z]{4}$" },
        "SIGNED_BY": { "type": "string" },
        "DATE_OF_BIRTH": { "type": "string", "pattern": "^[0-9]{2}/[0-9]{2}/[0-9]{4}$" },
        "APPLICATION_CODE": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "NAME": { "type": "string" }
      }
    },
    "responseCode": { "type": "string", "pattern": "^[0-9]{4}$" },
    "message": { "type": "string" },
    "responseEncrypted": { "type": "boolean" },
    "traceId": { "type": "string", "minLength": 8 }
  }
}
