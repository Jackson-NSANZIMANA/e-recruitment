{
  "name": "@usrp/g2g-sandbox",
  "version": "1.0.0",
  "private": true,
  "description": "USRP G2G production sandbox (ADR-047): dependency-free simulators speaking the real IremboGov/NIDA and SDMS/NESA wire formats, a synthetic national population and scenario personas. Refuses production.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts'",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@usrp/shared-config": "workspace:*",
    "@usrp/shared-http": "workspace:*",
    "@usrp/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
