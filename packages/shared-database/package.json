{
  "name": "@usrp/shared-database",
  "version": "1.0.0",
  "private": true,
  "description": "Drizzle ORM schemas, migrations, and seeds for USRP PostgreSQL database",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./client": {
      "import": "./src/client.ts",
      "types": "./src/client.ts"
    },
    "./schemas/public-core": {
      "import": "./src/schemas/public-core.schema.ts",
      "types": "./src/schemas/public-core.schema.ts"
    },
    "./schemas/rdf-ops": {
      "import": "./src/schemas/rdf-ops.schema.ts",
      "types": "./src/schemas/rdf-ops.schema.ts"
    },
    "./schemas/rnp-ops": {
      "import": "./src/schemas/rnp-ops.schema.ts",
      "types": "./src/schemas/rnp-ops.schema.ts"
    },
    "./schemas/rcs-ops": {
      "import": "./src/schemas/rcs-ops.schema.ts",
      "types": "./src/schemas/rcs-ops.schema.ts"
    },
    "./schemas/audit-log": {
      "import": "./src/schemas/audit-log.schema.ts",
      "types": "./src/schemas/audit-log.schema.ts"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seeds/run-seeds.ts",
    "db:seed:campaigns": "tsx src/seeds/campaigns.seed.ts",
    "db:seed:venues": "tsx src/seeds/venues.seed.ts",
    "db:seed:test-applicants": "tsx src/seeds/test-applicants.seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "@types/node": "^24.0.0"
  }
}
