{
  "name": "@usrp/shared-database",
  "version": "1.0.0",
  "private": true,
  "description": "Drizzle ORM schemas, migrations, and seeds for USRP PostgreSQL database",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "//exports": "Runtime resolves to compiled dist JS (so `node dist` works); types resolve to src .ts. This deliberately serves types from source to sidestep TS declaration-emit fragility on drizzle's inferred model types (TS2742). The .sql migrations and drizzle.config stay in src and are untouched by this build.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./dist/client.js"
    },
    "./schemas/public-core": {
      "types": "./src/schemas/public-core.schema.ts",
      "import": "./dist/schemas/public-core.schema.js"
    },
    "./schemas/rdf-ops": {
      "types": "./src/schemas/rdf-ops.schema.ts",
      "import": "./dist/schemas/rdf-ops.schema.js"
    },
    "./schemas/rnp-ops": {
      "types": "./src/schemas/rnp-ops.schema.ts",
      "import": "./dist/schemas/rnp-ops.schema.js"
    },
    "./schemas/rcs-ops": {
      "types": "./src/schemas/rcs-ops.schema.ts",
      "import": "./dist/schemas/rcs-ops.schema.js"
    },
    "./schemas/audit-log": {
      "types": "./src/schemas/audit-log.schema.ts",
      "import": "./dist/schemas/audit-log.schema.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "echo 'No runnable seeder yet. src/seeds/exam-venues.seed.ts exports venue DATA only; a run-seeds entrypoint is not built. See docs/architecture/ci-quality-gate.md.' && exit 1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "@types/node": "^24.0.0"
  }
}
