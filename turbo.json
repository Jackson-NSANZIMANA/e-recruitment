{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "REDIS_URL",
        "KAFKA_BROKERS"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "LOG_LEVEL",
        "PORT",
        "PORT_IDENTITY_SERVICE",
        "PORT_ELIGIBILITY_SERVICE",
        "PORT_BIOMETRIC_SERVICE",
        "PORT_DOCUMENT_FORENSICS_SERVICE",
        "PORT_BACKGROUND_VETTING_SERVICE",
        "PORT_APPLICATION_SERVICE",
        "PORT_SCHEDULING_SERVICE",
        "PORT_NOTIFICATION_SERVICE",
        "PORT_FIELD_SYNC_SERVICE",
        "PORT_AUDIT_SERVICE",
        "PORT_IAM_SERVICE",
        "DATABASE_URL",
        "DATABASE_MAX_CONNECTIONS",
        "KAFKA_BROKERS",
        "KAFKA_SSL",
        "APPLICATION_SLOT_PROJECTION_GROUP",
        "NATIONAL_ID_HMAC_KEY",
        "PII_ENCRYPTION_KEY",
        "JWT_ISSUER",
        "JWT_AUDIENCE",
        "AUTH_JWT_PUBLIC_KEY_B64",
        "AUTH_JWT_PRIVATE_KEY_B64",
        "QR_SIGNING_PRIVATE_KEY_B64",
        "QR_SIGNING_KEY_ID",
        "QR_INVITATION_PUBLIC_KEY_B64",
        "IAM_BASE_URL",
        "APPLICATION_SERVICE_BASE_URL",
        "IDENTITY_CLIENT_ID",
        "IDENTITY_CLIENT_SECRET",
        "G2G_TIMEOUT_MS",
        "NIDA_BASE_URL",
        "NIDA_HMAC_SECRET",
        "NIDA_REQUEST_TIMEOUT_MS",
        "NESA_BASE_URL",
        "NESA_HMAC_SECRET",
        "NESA_REQUEST_TIMEOUT_MS",
        "HEC_BASE_URL",
        "HEC_HMAC_SECRET",
        "HEC_REQUEST_TIMEOUT_MS",
        "RIB_BASE_URL",
        "RIB_HMAC_SECRET",
        "RIB_REQUEST_TIMEOUT_MS",
        "MINIO_ENDPOINT",
        "MINIO_PORT",
        "MINIO_USE_SSL",
        "MINIO_ROOT_USER",
        "MINIO_ROOT_PASSWORD",
        "MINIO_BUCKET_DOCUMENTS",
        "MINIO_BUCKET_FORENSICS",
        "MINIO_ENCRYPTION_KEY",
        "CLAMAV_HOST",
        "CLAMAV_PORT",
        "CLAMAV_TIMEOUT_MS",
        "BIOMETRIC_LIVENESS_THRESHOLD",
        "BIOMETRIC_FACE_MATCH_THRESHOLD",
        "FORENSICS_MAX_FILE_SIZE_MB",
        "FORENSICS_ALLOWED_MIME_TYPES",
        "FIELD_SYNC_DEVICE_KEY_ALGORITHM",
        "FIELD_SYNC_STALE_WRITE_THRESHOLD_MS"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["NODE_ENV", "DATABASE_URL", "REDIS_URL"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["NODE_ENV", "DATABASE_URL", "REDIS_URL", "KAFKA_BROKERS"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:seed": {
      "cache": false,
      "env": ["DATABASE_URL", "NODE_ENV"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    }
  }
}
