# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
coverage/
.turbo/

# Environment files (NEVER commit these)
.env
.env.local
.env.*.local
.env.production
.env.staging

# Docker volumes (local)
.docker-volumes/

# Kubernetes secrets (local)
infrastructure/kubernetes/secrets/

# Terraform state (sensitive)
infrastructure/terraform/**/.terraform/
infrastructure/terraform/**/terraform.tfstate
infrastructure/terraform/**/terraform.tfstate.backup
infrastructure/terraform/**/*.tfvars
!infrastructure/terraform/**/*.tfvars.example

# IDE
.idea/
.vscode/settings.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test artifacts
junit.xml
test-results/

# Schema-drift proof scratch (verify-schema-drift.ts cleans up after itself;
# this catches leftovers from an aborted run). Kept inside the repo on
# purpose — /tmp is aggressively cleaned on dev boxes mid-run.
packages/shared-database/.drift-check/

# HSM / Certificate artifacts (never commit)
*.pem
*.key
*.crt
*.p12
*.pfx
!infrastructure/docker/certs/.gitkeep
