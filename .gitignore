# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
coverage/
.turbo/

# ─────────────────────────────────────────────────────────────────────────────
# Environment files (NEVER commit these)
#
# DENY BY DEFAULT, then allow back the templates. This shape is deliberate.
#
# The previous version of this block listed five exact names. That is an
# allowlist pretending to be a denylist: it only protects the suffixes someone
# already thought of, and it fails silently in the leaking direction. It missed
# `.env.backup.<timestamp>`, which is how a real 10 KB env file reached main.
#
# Do not add exceptions here without a review. If you need a new tracked
# template, name it `*.example` and it is already covered.
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
*.env
!.env.example
!.env.*.example

# Backup/editor copies, which routinely sit next to a real secret file
*.backup
*.bak
*.orig
*.save
*~

# Docker volumes (local)
.docker-volumes/

# Kubernetes secrets (local)
infrastructure/kubernetes/secrets/

# Terraform state (sensitive)
infrastructure/terraform/**/.terraform/
infrastructure/terraform/**/terraform.tfstate
infrastructure/terraform/**/terraform.tfstate.backup
infrastructure/terraform/**/*.tfvars
!infrastructure/terraform/**/*.tfvars.example

# IDE
.idea/
.vscode/settings.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test artifacts
junit.xml
test-results/

# Schema-drift proof scratch (verify-schema-drift.ts cleans up after itself;
# this catches leftovers from an aborted run). Kept inside the repo on
# purpose — /tmp is aggressively cleaned on dev boxes mid-run.
packages/shared-database/.drift-check/

# HSM / Certificate artifacts (never commit)
# Same deny-by-default reasoning as the env block above.
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
*.pkcs12
!infrastructure/docker/certs/.gitkeep
