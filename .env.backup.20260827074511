# ══════════════════════════════════════════════════════════════════
# USRP — UNIFIED SECURITY RECRUITMENT PORTAL
# Environment Variables Reference
#
# SECURITY NOTICE: This file documents required variables.
# Copy to .env for local development ONLY.
# NEVER commit .env to version control.
# Production secrets are managed via HSM + Kubernetes Secrets.
# ══════════════════════════════════════════════════════════════════

# ── NODE ──────────────────────────────────────────────────────────
NODE_ENV=development

# ── POSTGRESQL ────────────────────────────────────────────────────
DATABASE_URL=postgresql://usrp_app:app_pw@localhost:5432/usrp_db
POSTGRES_USER=usrp_admin
POSTGRES_PASSWORD=usrp_dev_password
POSTGRES_DB=usrp_db
# PII column encryption key — loaded by loadSecurityConfig() minLength:32
# used as app.encryption_key session var for pgp_sym_encrypt on PII columns
PII_ENCRYPTION_KEY=dev_pii_encryption_key_min_32_chars_ok!!
DB_ENCRYPTION_KEY=dev_pii_encryption_key_min_32_chars_ok!!

# National ID HMAC key — fed into hashNationalId() → HMAC-SHA256(rawNID, key)
# the 64-char hex digest is the only NID representation stored in the DB
NATIONAL_ID_HMAC_KEY=dev_national_id_hmac_key_min_32_chars!!

# ── KAFKA (KRaft mode — no Zookeeper) ────────────────────────────
# localhost:29092 = host listener (services on host); kafka:9092 = in-network
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=usrp-service
KAFKA_GROUP_ID_IDENTITY=usrp-identity-consumers
KAFKA_GROUP_ID_ELIGIBILITY=usrp-eligibility-consumers
KAFKA_GROUP_ID_FORENSICS=usrp-forensics-consumers
KAFKA_GROUP_ID_VETTING=usrp-vetting-consumers
KAFKA_GROUP_ID_SCHEDULING=usrp-scheduling-consumers
KAFKA_GROUP_ID_NOTIFICATION=usrp-notification-consumers
KAFKA_GROUP_ID_AUDIT=usrp-audit-consumers
SCHEMA_REGISTRY_URL=http://localhost:8081

# ── MINIO (Document Object Store) ────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=usrp_minio_admin
MINIO_ROOT_PASSWORD=usrp_minio_dev_password
MINIO_BUCKET_DOCUMENTS=usrp-documents
MINIO_BUCKET_FORENSICS=usrp-forensics-temp
# AES-256-GCM key used by aesGcmEncrypt() in shared-security — minLength:32
MINIO_ENCRYPTION_KEY=dev_minio_encryption_key_min_32chars!!

# ── AUTH (Ed25519 asymmetric bearer tokens) ──────────────────────
# Dev-only committed keypair — same values used by run-selfchecks.sh
# PUBLIC key: every service that exposes HTTP loads this to verify tokens
AUTH_JWT_PUBLIC_KEY_B64=LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUNvd0JRWURLMlZ3QXlFQUpjb2FtWEM1NFMvTk51UDRlcXVzLzh5dlhuTk5yTkRhK0JGWFFuSkU1QzQ9Ci0tLS0tRU5EIFBVQkxJQyBLRVktLS0tLQo=
# PRIVATE key: iam-service ONLY — the sole token issuer
AUTH_JWT_PRIVATE_KEY_B64=LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCk1DNENBUUF3QlFZREsyVndCQ0lFSUlUaGJCTVJ0Sm9WQUwzUURrK29yZUgwVTludWw3RUNBNFdRRUxiV21LZmwKLS0tLS1FTkQgUFJJVkFURSBLRVktLS0tLQo=
JWT_ISSUER=usrp
JWT_AUDIENCE=usrp-services

# ── G2G: NIDA INTEGRATION ────────────────────────────────────────
# HMAC secrets must match the HMAC_SECRET env var in docker-compose.tier1.yml
# shared-config reads NIDA_BASE_URL; NIDA_API_BASE_URL kept for legacy compat
NIDA_BASE_URL=http://localhost:3100
NIDA_API_BASE_URL=http://localhost:3100
NIDA_API_KEY=dev-nida-key
NIDA_HMAC_SECRET=dev_nida_hmac_secret
