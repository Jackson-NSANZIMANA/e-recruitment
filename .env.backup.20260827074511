NESA_HMAC_SECRET=dev_nesa_hmac_secret
NESA_REQUEST_TIMEOUT_MS=8000
NESA_MAX_RETRIES=3

# ── G2G: RIB INTEGRATION ─────────────────────────────────────────
RIB_BASE_URL=http://localhost:3102
