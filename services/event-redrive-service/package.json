{
  "name": "@usrp/event-redrive-service",
  "version": "1.0.0",
  "private": true,
  "description": "USRP Event Re-drive Service — the schedule for dead letters (ADR-050, D2): durable per-letter state, backoff, a group circuit breaker, and a parked hand-off. No business routes.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts'",
    "selfcheck": "tsx selfcheck/verify-redrive-policy.ts"
  },
  "dependencies": {
    "@usrp/shared-config": "workspace:*",
    "@usrp/shared-database": "workspace:*",
    "@usrp/shared-events": "workspace:*",
    "@usrp/shared-http": "workspace:*",
    "@usrp/shared-logging": "workspace:*",
    "@usrp/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "kafkajs": "^2.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
