{
  "name": "@usrp/edge-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "USRP Edge Gateway — the ONLY browser-reachable origin (ADR-021). Holds the upstream credential server-side and hands the browser an opaque session handle.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "selfcheck": "tsx selfcheck/verify-edge-slice.ts"
  },
  "dependencies": {
    "@usrp/application-service": "workspace:*",
    "@usrp/iam-service": "workspace:*",
    "@usrp/identity-service": "workspace:*",
    "@usrp/shared-auth": "workspace:*",
    "@usrp/shared-config": "workspace:*",
    "@usrp/shared-database": "workspace:*",
    "@usrp/shared-http": "workspace:*",
    "@usrp/shared-security": "workspace:*",
    "@usrp/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "postgres": "^3.4.5",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
