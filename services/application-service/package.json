{
  "name": "@usrp/application-service",
  "version": "1.0.0",
  "private": true,
  "description": "USRP Application Service — the front door: turns a verified applicant's agency+category choice into an application and emits APPLICANT_SUBMITTED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "selfcheck": "tsx selfcheck/verify-submit-http-slice.ts",
    "selfcheck:pipeline": "tsx selfcheck/verify-pipeline-e2e.ts"
  },
  "dependencies": {
    "@usrp/shared-auth": "workspace:*",
    "@usrp/shared-config": "workspace:*",
    "@usrp/shared-database": "workspace:*",
    "@usrp/shared-events": "workspace:*",
    "@usrp/shared-http": "workspace:*",
    "@usrp/shared-security": "workspace:*",
    "@usrp/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@usrp/background-vetting-service": "workspace:*",
    "@usrp/eligibility-service": "workspace:*",
    "@usrp/scheduling-service": "workspace:*",
    "postgres": "^3.4.5",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
